# News Intelligence API - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# Groq API Configuration (Primary LLM Provider)
# =============================================================================
# Get your free API key at: https://console.groq.com
# This is REQUIRED for full functionality. Without it, the API will use
# rule-based fallback classification (lower accuracy).
GROQ_API_KEY=

# Groq model to use (default: openai/gpt-oss-120b)
# Available models: see https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Groq API timeout in seconds (default: 30)
GROQ_TIMEOUT=30

# =============================================================================
# Retry Configuration
# =============================================================================
# Maximum number of retry attempts for failed API calls (default: 3)
MAX_RETRY_ATTEMPTS=3

# Minimum wait time between retries in seconds (default: 2)
RETRY_MIN_WAIT=2

# Maximum wait time between retries in seconds (default: 10)
RETRY_MAX_WAIT=10

# Retry multiplier for exponential backoff (default: 1)
RETRY_MULTIPLIER=1

# =============================================================================
# Application Configuration
# =============================================================================
# Application name
APP_NAME=News Intelligence API

# Application version
APP_VERSION=1.0.0

# Debug mode (true/false) - DO NOT enable in production
DEBUG=false

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# CORS Configuration
# =============================================================================
# Allowed origins for CORS (comma-separated list)
# For local development, include your frontend URLs
# Example: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
